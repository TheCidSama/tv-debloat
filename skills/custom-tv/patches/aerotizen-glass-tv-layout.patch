new file mode 100644
index 0000000..10991e9
--- /dev/null
+++ b/launcher/src/home/components/Halo.tsx
@@ -0,0 +1,22 @@
+import { useLayoutEffect, useState } from 'preact/hooks';
+
+interface Glow { colour: string; x: number }
+
+// Background halo in the focused app's colour. Two half-size layers cross-fade with opacity
+// only, so a focus change paints one small gradient and the TV composites the rest.
+export const Halo = ({ colour, x }: Glow) => {
+  const [layers, setLayers] = useState<{ glows: [Glow, Glow]; front: 0 | 1 }>({ glows: [{ colour, x }, { colour, x }], front: 0 });
+  useLayoutEffect(() => {
+    setLayers(current => {
+      const shown = current.glows[current.front];
+      if (shown.colour === colour && shown.x === x) { return current; }
+      const back = current.front === 0 ? 1 : 0, glows: [Glow, Glow] = [...current.glows];
+      glows[back] = { colour, x };
+      return { glows, front: back };
+    });
+  }, [colour, x]);
+  return <div class="halo" aria-hidden="true">
+    {layers.glows.map((glow, i) => <i key={i} class={'halo-layer' + (layers.front === i ? ' on' : '')}
+      style={{ backgroundImage: 'radial-gradient(ellipse 560px 380px at ' + Math.round(glow.x / 2) + 'px 330px, ' + glow.colour + ' 0%, transparent 100%)' }} />)}
+  </div>;
+};
