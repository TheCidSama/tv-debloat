+
+// Halo colour for a brand: the first colour of its background, or its logo colour when the
+// background is near white (YouTube), since a white halo would wash the screen out.
+const haloColour = (background: string, logo: string) => {
+  const colour = background.match(/#[0-9a-f]{3,8}\b|(?:rgb|hsl)a?\([^)]*\)/i)?.[0];
+  const hex = colour && /^#[0-9a-f]{6}$/i.test(colour) ? colour : null;
+  if (hex) {
+    const [r, g, b] = [1, 3, 5].map(i => parseInt(hex.slice(i, i + 2), 16));
+    if (0.299 * r + 0.587 * g + 0.114 * b > 200) { return logo; }
+  }
+  return colour || logo;
+};
 export const Home = ({ env }: { env: HomeEnvironment }) => {
-  const settings = useStore(env.settings), { page, active, draft, moving } = useStore(env.state);
+  const settings = useStore(env.settings), { page, active, draft, moving, selected } = useStore(env.state);
   const { apps, inputs, items, ready } = useStore(env.inventory);
   const home = draft || (settings.home.length || env.runtime.settings.home !== null ? settings.home : [env.runtime.config.FIREPLACE_ID]);
   const visibleHome = home.filter(id => id === env.runtime.config.FIREPLACE_ID || !ready || apps.some(app => app.id === id));
   const size = settings.cardSize === 'small' ? 'small' : 'big';
+  // The glass themes use the TV layout: clock above, apps along the bottom, halo behind focus.
+  const tv = settings.theme !== 'classic';
+  const columns = env.columns(settings);
+  const glow = (() => {
+    const accent = { colour: 'rgb(124,92,255)', x: 560 };
+    if (!tv || !selected.startsWith('app:')) { return accent; }
+    const id = selected.slice(4), list = page === 'home' ? visibleHome : apps.map(app => app.id);
+    const column = Math.max(0, list.indexOf(id)) % columns;
+    // Tile centre: the row starts at 64px and spans 1792px.
+    const x = 64 + (column + 0.5) * (1792 / columns);
+    if (id === env.runtime.config.FIREPLACE_ID) { return { colour: '#ff6a10', x }; }
+    const app = apps.find(item => item.id === id), brand = app && env.describe(app);
