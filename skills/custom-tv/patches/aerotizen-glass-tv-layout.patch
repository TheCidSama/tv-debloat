diff --git a/launcher/js/theme.js b/launcher/js/theme.js
new file mode 100644
index 0000000..89f8d47
--- /dev/null
+++ b/launcher/js/theme.js
@@ -0,0 +1,47 @@
+// Appearance: glass themes and accent colour.
+// Everything is a body class or CSS variable, so css/glass.css owns the look.
+// No backdrop-filter: over the animated wallpaper the TV would re-blur every frame.
+(function (A) {
+  'use strict';
+
+  var THEMES = [
+    { id: 'glass', name: 'Glass', hint: 'Dark frosted panels' },
+    { id: 'frost', name: 'Frost', hint: 'Bright, milky glass' },
+    { id: 'crystal', name: 'Crystal', hint: 'Glass tinted with your accent' },
+    { id: 'classic', name: 'Classic', hint: 'The original flat look' }
+  ];
+  var ACCENTS = [
+    { id: 'violet', name: 'Violet', hex: '#7c5cff', rgb: '124,92,255' },
+    { id: 'blue', name: 'Blue', hex: '#3d8bff', rgb: '61,139,255' },
+    { id: 'teal', name: 'Teal', hex: '#20c9b0', rgb: '32,201,176' },
+    { id: 'green', name: 'Green', hex: '#4ad26e', rgb: '74,210,110' },
+    { id: 'amber', name: 'Amber', hex: '#ffb02e', rgb: '255,176,46' },
+    { id: 'rose', name: 'Rose', hex: '#ff5c8c', rgb: '255,92,140' },
+    { id: 'red', name: 'Red', hex: '#ff5448', rgb: '255,84,72' }
+  ];
+  function find(list, id) {
+    for (var i = 0; i < list.length; i++) { if (list[i].id === id) { return list[i]; } }
+    return list[0];
+  }
+
+  function apply() {
+    var s = A.settings, theme = find(THEMES, s.theme), accent = find(ACCENTS, s.accent);
+    var body = document.body, root = document.documentElement;
+    THEMES.forEach(function (t) { body.classList.toggle('theme-' + t.id, t.id === theme.id); });
+    // glass-ui predates the themes and still styles the header plates.
+    body.classList.toggle('glass-ui', theme.id !== 'classic');
+    body.classList.toggle('no-hero', s.heroTitle === false);
+    root.style.setProperty('--focus', accent.hex);
+    root.style.setProperty('--accent-rgb', accent.rgb);
+  }
+
+  A.theme = {
+    THEMES: THEMES,
+    ACCENTS: ACCENTS,
+    apply: apply,
+    start: function () {
+      apply();
+      A.settings.subscribe(apply);
+    }
+  };
+})(window.AeroTizen);
